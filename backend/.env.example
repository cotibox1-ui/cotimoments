# ===== BASE DE DATOS =====
# Crea un cluster gratuito en https://www.mongodb.com/cloud/atlas
# Luego "Connect" -> "Drivers" -> copia el connection string y reemplaza <password>
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/box-personalizados

# ===== AUTENTICACIÓN =====
# Cualquier cadena larga y aleatoria. Genera una con: openssl rand -hex 32
JWT_SECRET=

# ===== CLOUDINARY (imágenes) =====
# Crea cuenta gratuita en https://cloudinary.com -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== WHATSAPP =====
# Solo necesario si más adelante activas notificaciones automáticas vía
# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp)
# El botón "Enviar comprobante por WhatsApp" del cliente NO requiere esto,
# funciona con wa.me y no necesita credenciales.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== GENERAL =====
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://tu-dominio-en-vercel.app

# Número de WhatsApp del negocio en formato internacional sin '+' ni espacios
# Ej: 51987654321  (este es el que se usa en el botón wa.me del cliente)
BUSINESS_WHATSAPP_NUMBER=51975335798
