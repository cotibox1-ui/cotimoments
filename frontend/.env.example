VITE_API_URL=https://tu-backend-en-railway.up.railway.app/api

# URL pública real de tu web (la de Vercel). Se usa para armar el link
# "Copiar link para armar box" del Dashboard. Es necesaria sobre todo
# dentro de la APK, donde la URL del navegador no es la real.
VITE_PUBLIC_URL=https://cotimoments.vercel.app

# SOLO para generar la APK: credenciales con las que la app entra sola,
# sin mostrar pantalla de login. NO se sube a GitHub (está en .gitignore).
# Déjalas vacías si vas a usar la versión web normal con login manual.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=
